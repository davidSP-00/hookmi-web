# Secreto usado para firmar la cookie de "video desbloqueado".
# Genera uno propio con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNLOCK_SECRET=

# Número de WhatsApp de la tienda, formato internacional sin "+" ni espacios (ej. 56912345678)
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=
